@{
    ViewData["Title"] = "Details Page";
}

@model MovieTicket.Models.movie
<div style="display: flex; justify-content: center; align-items: center;">

<div style="width: 500px; border: 2px dashed black; text-align: center; font-size:20px">
    <h3 style="color:blue">Booking Details</h3>
    <hr />
    <p><strong>Name:</strong> @Model.name</p>
    <p><strong>Gender:</strong> @Model.gender</p>
        <p><strong>Date Of Birth:</strong> @Model.dateofbirth</p>
    <p><strong>Age:</strong> @Model.age</p>
    <hr />
    <a href="@Url.Action("Index", "Home")">Back to Home</a>
</div>
</div>