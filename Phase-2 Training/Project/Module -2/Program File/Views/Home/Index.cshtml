@{
    ViewData["Title"] = "Home Page";
}
<body style="background-color:#1a1a1a;color:white">
<div class="text-center">
    <h1 class="display-4">Welcome To Coolie Movie Ticket Booking</h1>
    <div>
        <img style="padding:20px" src="data:image/jpeg;base64," alt="Coolie BlockBuster Hit" />
    </div>
        <a class="btn btn-secondary text-decoration-none" asp-action="BookTicket" style="color:white"> Click To Book Ticket</a>
        <a class="btn btn-danger text-decoration-none" asp-action="MovieDetail" >Click To View Booking</a>
</div>

<h3 class ="text-primary"> Cast </h3>

<div>
    <p>
        Rajinikanth, Nagarjuna, Upendra, Sathyaraj, and Shruti Haasan in lead roles, with Aamir Khan in a cameo. The film, directed by Lokesh Kanagaraj, also includes Soubin Shahir, Reba Monica John, and others in supporting roles.
    </p>
</div>

<div>
    <h4 class="text-primary">About the Movie</h4>
    <p>
        "Coolie" is an upcoming action-thriller combining the charisma of legendary stars
        with gripping storytelling. Set against a backdrop of high-stakes drama, the film
        is expected to deliver spectacular visuals, intense action sequences, and
        unforgettable performances.
    </p>
</div>
</body>
 









